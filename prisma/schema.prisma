// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum HttpMethod {
    GET
    POST
    PUT
    PATCH
    DELETE
    HEAD
}

model ApiCall {
    id          String     @id @default(cuid())
    name        String
    url         String
    method      HttpMethod @default(GET)
    headers     Json? // Record<string, string>
    body        String? // raw request body, unused for GET/HEAD
    cadenceDays Int        @default(1) // minimum 1 = at most once per day

    enabled Boolean @default(false)

    lastRunAt DateTime?
    lastRunOk Boolean?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
    createdById String

    responses ApiCallResponse[]

    @@index([createdById])
    @@index([enabled])
}

model ApiCallResponse {
    id         String  @id @default(cuid())
    apiCall    ApiCall @relation(fields: [apiCallId], references: [id], onDelete: Cascade)
    apiCallId  String
    status     Int?
    statusText String?
    headers    Json?
    body       String?
    ok         Boolean
    error      String?
    durationMs Int

    createdAt DateTime @default(now())

    @@index([apiCallId, createdAt])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    apiCalls      ApiCall[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
